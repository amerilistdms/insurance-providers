# Public site URL used for canonical links, the sitemap, and Open Graph.
# Replace with the live domain before launch. Indexing stays off until then.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false until legal review is complete and the site is approved to be indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Lead delivery stays off until both values below are set.
# The form will not pretend a submission succeeded while this is false.
# Before turning it on:
# 1. Confirm the webhook with the business and compliance team.
# 2. Approve privacy, lead-sharing, and any call/text consent language.
# 3. Set LEAD_WEBHOOK_URL to an https endpoint (http allowed only for localhost).
# 4. Set NEXT_PUBLIC_LEADS_ENABLED=true and rebuild.
NEXT_PUBLIC_LEADS_ENABLED=false
# LEAD_WEBHOOK_URL=https://example.com/approved-lead-endpoint
